# SI3LN Environment Variables Template
# Copy this file to .env and update the values

# ====== Django Settings ======
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,api,frontend

# ====== Database ======
# Leave empty to use SQLite (development)
# DATABASE_URL=postgresql://si3ln_user:si3ln_password@db:5432/si3ln_db
DATABASE_URL=

# PostgreSQL specific (for docker-compose)
POSTGRES_DB=si3ln_db
POSTGRES_USER=si3ln_user
POSTGRES_PASSWORD=si3ln_password

# ====== Redis Cache ======
REDIS_URL=redis://redis:6379/0

# ====== JWT Authentication ======
JWT_SECRET_KEY=your-jwt-secret-change-in-production
JWT_PEPPER=your-pepper-change-in-production
JWT_EXPIRATION_HOURS=24

# ====== CORS Settings ======
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000

# ====== Email Settings (Optional) ======
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-password

# ====== Production Settings ======
# When deploying to production, set these:
# DEBUG=False
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# DATABASE_URL=postgresql://user:password@db-host:5432/dbname
# SECRET_KEY=very-long-random-string
# JWT_SECRET_KEY=another-long-random-string
