# Copy this file to .env and fill in your values
# cp env/.env.example env/.env

# ─── Django ──────────────────────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret
JWT_PEPPER=change-me-pepper
JWT_EXPIRATION_HOURS=24

# ─── Database (Docker service name: db) ──────────────────────────────────────
DATABASE_URL=postgresql://si3ln_user:si3ln_password@db:5432/si3ln_db
POSTGRES_DB=si3ln_db
POSTGRES_USER=si3ln_user
POSTGRES_PASSWORD=si3ln_password

# ─── Redis (Docker service name: redis) ──────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# ─── Python Game (optional – desktop play outside Docker) ────────────────────
# SI3LN_API_URL=http://localhost:8000
# SI3LN_TOKEN=<player jwt token>
