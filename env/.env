# ─── Django ──────────────────────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=dev-secret-key-for-testing-only
ALLOWED_HOSTS=localhost,127.0.0.1,api

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=dev-jwt-secret-key-for-testing
JWT_PEPPER=dev-pepper-secret
JWT_EXPIRATION_HOURS=24

# ─── Database (Docker service name: db) ──────────────────────────────────────
DATABASE_URL=postgresql://si3ln_user:si3ln_password@db:5432/si3ln_db
POSTGRES_DB=si3ln_db
POSTGRES_USER=si3ln_user
POSTGRES_PASSWORD=si3ln_password

# ─── Redis (Docker service name: redis) ──────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── CORS ────────────────────────────────────────────────────────────────────
# Add the frontend origin so the browser does not block API calls
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# ─── Python Game (optional – set when running desktop game outside Docker) ───
# SI3LN_API_URL=http://localhost:8000
# SI3LN_TOKEN=<your jwt token>
